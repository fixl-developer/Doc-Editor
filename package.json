{
  "name": "@fixl-developer/doc-editor",
  "version": "0.1.0",
  "description": "Zero-dependency rich text document editor engine + React bindings, built on native contenteditable/Selection APIs. No editor libraries (no Tiptap/ProseMirror/Slate/Quill), no PDF/docx/collab libraries.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles/doc-editor.css"
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "contenteditable",
    "document-editor",
    "react",
    "zero-dependency",
    "docx-export",
    "collaborative-editing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixl-developer/Doc-Editor.git"
  },
  "homepage": "https://github.com/fixl-developer/Doc-Editor#readme",
  "bugs": {
    "url": "https://github.com/fixl-developer/Doc-Editor/issues"
  },
  "author": "fixl-developer",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
